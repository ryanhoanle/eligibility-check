# apps/api — copy to apps/api/.env (all optional; these are the defaults)
PORT=4000
DATABASE_URL=./data/eligibility.db
CORS_ORIGINS=http://localhost:5173
PAYER_LATENCY_MIN_MS=150
PAYER_LATENCY_MAX_MS=600
LOG_LEVEL=info

# apps/web — copy to apps/web/.env (optional). Defaults to the Vite proxy at /api.
# VITE_API_BASE=http://localhost:4000
